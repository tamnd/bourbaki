#!/bin/sh
#
# The hygiene rules, run before the commit rather than after the push.
#
# H01 to H05 are the rules about what is in the repository rather than about
# what the mathematics says: no PDF, no page image outside figures/, nothing
# over 512 KB, nothing secret shaped, LF endings with one trailing newline. All
# five are cheap and all five are about a mistake that is a nuisance to undo
# once it is in the history, which is the case for a hook and not for CI.
#
# H06 is left out. It reads the whole corpus to check the README coverage table
# and it is the one hygiene rule that is slow, and a hook that costs a second
# every commit is a hook people turn off.
#
# Install it with: bourbaki repo init-hooks
#
# It reads the index rather than the working tree, because git ls-files is the
# index, so what it checks is what is about to be committed and not what happens
# to be lying about in the directory.

set -e

root=$(git rev-parse --show-toplevel)

# The sibling checkout is next to the main checkout and not next to a worktree.
# A worktree of the corpus lives wherever it was made, /tmp among other places,
# and $root/../bourbaki-solver is nothing there, so the hook fell through to the
# installed binary and reported two files as broken front matter because that
# binary was three days old and predated the fields. The common git directory is
# inside the main checkout whichever of the two the commit is made from, so this
# is the one path that answers the same in both.
main=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)

# A sibling checkout of the solver first, then the installed binary, and
# otherwise nothing.
#
# The checkout comes first because whoever has one is working on both
# repositories at once, and the rules that matter to them are the ones in their
# working tree and not the ones in whatever they last installed. An installed
# binary goes stale quietly: the first version of this hook preferred it, found
# one that predated bourbaki audit, and reported the corpus as failing when what
# had happened was that the binary did not know the command.
#
# Skipping is right when neither is there. Somebody fixing a typo in the README
# should not be stopped by a Go toolchain they do not have, and CI runs the same
# rules on the same commit anyway.
if [ -d "$main/../bourbaki-solver" ]; then
	run="go run ./cmd/bourbaki"
	cd "$main/../bourbaki-solver"
elif command -v bourbaki >/dev/null 2>&1; then
	run="bourbaki"
else
	echo "pre-commit: no bourbaki binary and no sibling bourbaki-solver checkout, skipping the hygiene rules" >&2
	exit 0
fi

BOURBAKI_CORPUS="$root"
export BOURBAKI_CORPUS

# A finding in a file this commit does not touch is somebody else's, and it is
# already in the history. manifests/sections.yaml has been over the H03 limit
# since before the branch that is on now (#374), and a hook that refuses every
# commit for it is a hook that is passed --no-verify every time, which is worse
# than no hook: the next real H04 goes through on the same habit, because the
# author is typing the flag before reading what failed.
#
# So the finding is reported either way and only a finding in a staged file
# stops the commit. The rules still catch what they were written to catch --
# they are about a mistake that is a nuisance to undo once it is in the history,
# and a mistake nobody is making in this commit is already in it.
out=$($run audit -only H01,H02,H03,H04,H05 2>&1) || true
printf '%s\n' "$out" >&2

# The two lists go through files rather than through -v. A path list is long
# and has newlines in it, and the awk that ships with macOS will not take a
# newline in a -v assignment: it reports "newline in string" and stops.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM
# Both through -C "$root". By this point the working directory may be the
# sibling solver checkout, which the hook cd'd into to run the rules from
# source, and a bare git here would answer about that repository instead: it
# listed the solver's files as the corpus's, found manifests/sections.yaml
# nowhere among them, and refused the commit for a file nobody had staged.
git -C "$root" diff --cached --name-only --diff-filter=ACMR >"$tmp/staged"
git -C "$root" ls-files >"$tmp/tracked"

# A finding line is the rule, the file it is in, and what is wrong with it.
# Some rules point at a line as well, pages/foo.md:12, so the number comes off
# before the path is looked up. H01 to H05 are all per-file rules, but if one
# ever reports something that is not a file in the repository the finding is
# kept, because there is no way to tell whose it is and refusing is the safe
# side of not knowing.
mine=$(printf '%s\n' "$out" | awk -v sf="$tmp/staged" -v tf="$tmp/tracked" '
	BEGIN {
		while ((getline l < sf) > 0) if (l != "") s[l] = 1
		while ((getline l < tf) > 0) if (l != "") t[l] = 1
	}
	/^H[0-9][0-9][ \t]/ {
		f = $2
		sub(/:[0-9]+$/, "", f)
		if (!(f in t) || (f in s)) print
	}
')

if [ -n "$mine" ]; then
	echo >&2
	echo "pre-commit: the hygiene rules above failed on files this commit touches:" >&2
	printf '%s\n' "$mine" >&2
	echo >&2
	echo "Fix them, or commit with --no-verify and say in the message why." >&2
	exit 1
fi

# Standing findings are worth saying out loud, so that they are not forgotten
# just because they no longer stop anybody.
if printf '%s\n' "$out" | grep -qE '^H[0-9][0-9][ 	]'; then
	echo "pre-commit: the findings above are in files this commit does not touch, so they" >&2
	echo "do not stop it. They are still findings." >&2
fi
